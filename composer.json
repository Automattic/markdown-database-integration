{
    "name": "chubes4/markdown-database-integration",
    "description": "Native pure-PHP WordPress SQL engine backed by canonical Markdown and JSON files.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "automattic/blocks-engine-php-transformer": "0.45.258"
    },
    "autoload": {
        "classmap": [
            "inc/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "platform": {
            "php": "8.2"
        }
    }
}
