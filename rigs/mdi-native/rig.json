{
  "id": "mdi-native",
  "description": "Markdown Database Integration benchmark candidate using the verified native query runtime.",
  "lifecycle": {
    "cleanup": {
      "intent": "external",
      "reason": "WP Codebox owns disposable runtime cleanup; the MDI checkout is user-owned."
    }
  },
  "components": {
    "markdown-database-integration": {
      "component_id": "markdown-database-integration",
      "default_ref": "origin/main",
      "path": "${env.HOMEBOY_RIG_COMPONENT_PATH__MDI_NATIVE__MARKDOWN_DATABASE_INTEGRATION}",
      "path_setting": "HOMEBOY_RIG_COMPONENT_PATH__MDI_NATIVE__MARKDOWN_DATABASE_INTEGRATION",
      "checkout_root": "${env.HOMEBOY_RIG_COMPONENT_CHECKOUT_ROOT__MDI_NATIVE__MARKDOWN_DATABASE_INTEGRATION}",
      "branch": "main",
      "extensions": {
        "wordpress": {
          "bench_env": {
            "BENCH_CORPUS_SIZE": "100"
          },
          "wp_config_defines": {
            "MARKDOWN_DB_BACKEND": "mdi-native",
            "MARKDOWN_DB_CONTENT_DIR": "/wordpress/wp-content/db",
            "MARKDOWN_DB_STATE_DIR": "/wordpress/wp-content/db"
          },
          "wp_codebox_bench_mounts": [
            {
              "source": "${components.markdown-database-integration.path}/db.php",
              "target": "/wordpress/wp-content/db.php",
              "type": "file",
              "mode": "readonly",
              "phase": "pre-install"
            },
            {
              "source": "${components.markdown-database-integration.path}/tests/fixtures/native-bench-state",
              "target": "/wordpress/wp-content/db",
              "type": "directory",
              "mode": "readonly",
              "phase": "pre-install"
            }
          ]
        }
      }
    }
  },
  "resources": {
    "paths": [
      "${components.markdown-database-integration.path}"
    ]
  },
  "bench": {
    "default_component": "markdown-database-integration",
    "warmup_iterations": 5,
    "axes": {
      "backend": "mdi-native"
    }
  },
  "bench_workloads": {
    "wordpress": [
      {
        "path": "${package.root}/tests/bench/boot-timing.php"
      },
      {
        "path": "${package.root}/tests/bench/bulk-import.php"
      },
      {
        "path": "${package.root}/tests/bench/obsidian-bursty.php"
      },
      {
        "path": "${package.root}/tests/bench/read-heavy.php"
      },
      {
        "path": "${package.root}/tests/bench/wiki-hierarchy.php"
      },
      {
        "path": "${package.root}/tests/bench/plugin-table-inventory.php"
      }
    ]
  },
  "bench_profiles": {
    "decision": [
      "boot-timing",
      "bulk-import",
      "obsidian-bursty",
      "read-heavy",
      "wiki-hierarchy",
      "plugin-table-inventory"
    ]
  },
  "pipeline": {
    "check": [
      {
        "kind": "requirement",
        "label": "MDI plugin checkout exists",
        "file": "${components.markdown-database-integration.path}/markdown-database-integration.php",
        "component": "markdown-database-integration",
        "remediation": "Set HOMEBOY_RIG_COMPONENT_PATH__MDI_NATIVE__MARKDOWN_DATABASE_INTEGRATION to an MDI checkout."
      }
    ],
    "up": [],
    "bench_prepare": [],
    "down": []
  }
}
